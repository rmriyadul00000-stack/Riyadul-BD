# ---- Front end (read by Vite at build time; safe to expose) ----
# Leave unset to use the project already configured in src/lib/config.ts.
# Set VITE_SUPABASE_URL to an empty value to run fully on browser storage (local preview).
# VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_xxx        # publishable key only — never the service role key

# ---- Netlify function: order confirmation email (server side, keep secret) ----
# Set real values in Netlify -> Site settings -> Environment variables. Never commit them.
RESEND_API_KEY=
ORDER_FROM=
ORDER_BCC=
